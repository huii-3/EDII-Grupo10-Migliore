    BSF     SSPSTAT,CKE           ;Datos transmitidos en flanco ascendente
    BANKSEL SSPCON
    BCF     SSPCON,CKP            ;Estado inactivo del clk en bajo
    BCF     SSPCON,SSPM3
    BCF     SSPCON,SSPM2          ;CLK de SPI = Fosc/4
    BCF     SSPCON,SSPM1
    BCF     SSPCON,SSPM0
    BSF     SSPCON,SSPEN          ;Habilita el puerto serie una vez
    ENDM                          ;configuradas todas las opciones
    
CFG_ISR MACRO
    BANKSEL TRISB
    BSF     TRISB,TRISB0
    BANKSEL ANSELH
    BCF     ANSELH,ANS12
    BANKSEL OPTION_REG
    BCF     OPTION_REG,NOT_RBPU   ;Resistencias pull-up internas habilitadas
    BCF     OPTION_REG,INTEDG     ;Interrupci�n RB0 por flanco descendente
    BANKSEL PIR1
    BCF     PIR1,ADIF             ;Bajo la bandera de Interrupci�n por ADC
    BANKSEL PIE1
    BSF     PIE1,ADIE             ;Habilita Interrupci�n por ADC
    BANKSEL INTCON
    BCF     INTCON,INTF           ;Limpio la flag de interrupi�n por flanco
    BSF     INTCON,INTE           ;Habilito la interrupci�n por flanco
    BCF     INTCON,T0IF           ;Baja la bandera de Interrupci�n por Timer0
    BSF     INTCON,T0IE           ;Habilita Interrupci�n por Timer0
    BSF     INTCON,PEIE           ;Habilita Interrupciones Perif�ricas
    BSF     INTCON,GIE            ;Habilito las interrupciones
    ENDM
    
CFG_IOC MACRO
    BANKSEL INTCON
    BCF     INTCON,RBIF           ;Limpio la flag de interrupci�n por IOC
    BSF     INTCON,RBIE           ;Habilita Interrupciones por IOC
    ENDM
    
CFG_UART_TX MACRO
    BANKSEL TRISC
    BCF     TRISC,TRISC6
    BANKSEL SPBRG
