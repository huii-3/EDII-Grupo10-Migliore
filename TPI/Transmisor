	MOVLW   .76
	MOVWF   NRF_DATA
	CALL    NRF_WRITE_RF_CH
	MOVLW   0x26
	MOVWF   NRF_DATA
	CALL    NRF_WRITE_RF_SETUP
	MOVLW   0x70
	MOVWF   NRF_DATA
	CALL    NRF_WRITE_STATUS
	MOVLW   0x4C
	MOVWF   0x20
	MOVLW   0x45
	MOVWF   0x21
	MOVLW   0x49
	MOVWF   0x22
	MOVLW   0x52
	MOVWF   0x23
	MOVLW   0x55
	MOVWF   0x24
	CALL    NRF_WRITE_TX_ADDR
	MOVLW   .3
	MOVWF   NRF_DATA
	CALL    NRF_WRITE_RX_PW_P0
	MOVLW   0x00
	MOVWF   NRF_DATA
	CALL    NRF_WRITE_DYNPD
	MOVLW   0x00
	MOVWF   NRF_DATA
	CALL    NRF_WRITE_FEATURE
	RETURN
	
	
;*******************************************************************************
; @brief    Conversi�n de binario natural (8-bits) a BCD desempaquetado.
;
; @details  - Descompone un valor binario crudo [0-255] almacenado en REG_BCD 
;             en sus componentes posicionales de Centenas, Decenas y Unidades 
;             mediante el m�todo de restas sucesivas. 
;	    - Los resultados se guardan en las variables UNIDAD, DECENA, CENTENA    
;*******************************************************************************    
CNV_BCD
        CLRF    VAL_UNIDAD 	   
        CLRF    VAL_DECENA
        CLRF    VAL_CENTENA
    TEST_CEN
	MOVLW   .100                
	SUBWF   REG_BCD,W   
	BTFSC   STATUS,C    
	GOTO    ADD_CEN     
	GOTO    TEST_DEC    
    TEST_DEC
	MOVLW   .10                                             
	SUBWF   REG_BCD,W   
	BTFSC   STATUS,C    
	GOTO    ADD_DEC    
	GOTO    TEST_UNI    
    TEST_UNI
	GOTO    ADD_UNI    
    ADD_CEN
	MOVWF   REG_BCD     
	INCF    VAL_CENTENA,F   
	GOTO    TEST_CEN                            
    ADD_DEC
	MOVWF   REG_BCD     
	INCF    VAL_DECENA,F   
	GOTO    TEST_DEC    
    ADD_UNI
	MOVF    REG_BCD,W   
	MOVWF   VAL_UNIDAD     
	RETURN
	
	
