    #include <NRF24L01.inc>
    
;*******************************************************************************
; @brief    Retardo por Software
;           
; @details  Implementa 3 bucles anidados
;           t_DELAY = (4/f_clk)*[(3*p*n*m)+(4*n*m)+(4*m)+5]
;******************************************************************************* 
DELAY_3LOOP
        MOVFW   DELAY1_Init   ;m
        MOVWF   DELAY1
    LOOP1
        MOVFW   DELAY2_Init   ;n
        MOVWF   DELAY2
    LOOP2
        MOVFW   DELAY3_Init   ;p
        MOVWF   DELAY3
    LOOP3
        DECFSZ  DELAY3,F
        GOTO    LOOP3
        DECFSZ  DELAY2,F
        GOTO    LOOP2
        DECFSZ  DELAY1,F
        GOTO    LOOP1
        RETURN
    
    
;*******************************************************************************
; @brief    Subrutina de servicio de interrupci�n por flanco en RB0
;*******************************************************************************
ISR_INT
        CALL    NRF_READ_STATUS
	BTFSC   NRF_DATA,RX_DR
	GOTO    SAVE_RX
	BTFSC   NRF_DATA,TX_DS
	GOTO    TX_END
	BTFSC   NRF_DATA,MAX_RT
	NOP
	GOTO    CLR_NRF_FLAGS
	
    SAVE_RX
        MOVLW   .3
	MOVWF   NRF_LENGTH
        CALL    R_RX_PAYLOAD
	GOTO    CLR_NRF_FLAGS
    
    TX_END
        BANKSEL PORTD
	BTFSS   LIGHTS,3
	BCF     LED3
	BTFSC   LIGHTS,3
	BSF     LED3
	BTFSS   LIGHTS,2
	BCF     LED2
	BTFSC   LIGHTS,2
	BSF     LED2
	BTFSS   LIGHTS,1
	BCF     LED1
	BTFSC   LIGHTS,1
	BSF     LED1
	BTFSS   LIGHTS,0
	BCF     LED0
	BTFSC   LIGHTS,0
	BSF     LED0
	GOTO    CHECK_TX_UART
	
    CHECK_TX_UART
        BANKSEL COUNTER_LM35
	MOVF    COUNTER_LM35,W
	SUBLW   .50
	BTFSS   STATUS,Z
	GOTO    CLR_NRF_FLAGS
	GOTO    START_TX_UART
	
    START_TX_UART
        BANKSEL LM35_VALUE
        MOVF    LM35_VALUE,W
	MOVWF   REG_BCD
	CALL    CNV_BCD
	
	MOVF    VAL_CENTENA,W
	ADDLW   d'48'
	CALL    UART_TX_BYTE
	
	MOVF    VAL_DECENA,W
	ADDLW   d'48'
	CALL    UART_TX_BYTE
	
	MOVF    VAL_UNIDAD,W
	ADDLW   d'48'
	CALL    UART_TX_BYTE
	
	MOVLW   d'10'               ;Salto de linea LF (\n)
	CALL    UART_TX_BYTE
	MOVLW   d'13'               ;Retorno de carro CR (\r)
	CALL    UART_TX_BYTE
	GOTO    CLR_NRF_FLAGS
	
    CLR_NRF_FLAGS
        MOVLW   0x70
	MOVWF   NRF_DATA
	CALL    NRF_WRITE_STATUS
	BANKSEL INTCON
	BCF     INTCON,INTF
	GOTO    ISR_FIN
	
	
;*******************************************************************************
; @brief    Subrutina de servicio de interrupci�n por cambio de nivel en el
;           puerto B
;*******************************************************************************
ISR_IOC
	BANKSEL PORTB
	MOVF    PORTB,W
	BANKSEL CURRENT_STATE    ;Leo el estado actual del puerto B y lo guardo
	MOVWF   CURRENT_STATE    ;Complemento el estado actual para dejar en 1
	COMF    CURRENT_STATE,W  ;solo el boton que se apret�
	ANDWF   PREVIOUS_STATE,W ;Comparo el estado actual con el anterior
	ANDLW   0xF0             ;Enmascaro el nibble alto que es el importa
	MOVWF   FLANKS           ;ya que all� est�n los botones y lo guardo
	
	MOVF    CURRENT_STATE,W  ;Actualizo el estado previo para la
	MOVWF   PREVIOUS_STATE   ;siguiente interrupci�n
	
	SWAPF   FLANKS,W         ;Doy vuelta los nibbles para el alto de FLANKS
	XORWF   LIGHTS,F         ;con el bajo de LIGHTS y actualizo el valor
	                         ;de LIGHTS
	BANKSEL INTCON
	BCF     INTCON,RBIF      ;Limpio la bandera de IOC
	GOTO    ISR_FIN

	
;*******************************************************************************
; @brief    Subrutina de servicio de interrupci�n para el Timer0
;*******************************************************************************
ISR_TMR0
        INCF    COUNTER_TMR0
        MOVFW   COUNTER_MAX_TMR0
        SUBWF   COUNTER_TMR0,W
        BTFSS   STATUS,Z
        GOTO    RELOAD_TMR0
	CLRF    COUNTER_TMR0
	GOTO    START_CONVERSION
	
    START_CONVERSION
        BANKSEL COUNTER_LM35     ;COUNTER_LM35 = 50 --> Enviar datos por UART
	INCF    COUNTER_LM35,F
        BANKSEL INTCON           ;Deshabilito las interrupciones por IOC para
	BCF     INTCON,RBIE      ;que no interrumpan durante la secuencia de 
	BANKSEL ADCON1           ;3 conversiones.
	BSF     ADCON1,VCFG0     ;Para la primera conversi�n (LM35) seteo la
	BANKSEL ADCON0           ;referencia de tensi�n del pin Vref+
	BSF     ADCON0,GO
	GOTO    RELOAD_TMR0
	
    RELOAD_TMR0
        MOVFW   OFFSET_TMR0
	MOVWF   TMR0
	GOTO    CLR_FLAG_TMR0
	
    CLR_FLAG_TMR0
        BANKSEL INTCON
	BCF     INTCON,T0IF
	GOTO    ISR_FIN


;*******************************************************************************
; @brief    Subrutina de servicio de interrupci�n para el ADC
;*******************************************************************************
ISR_ADC
	BANKSEL ADCON0
	MOVF    ADCON0,W
	ANDLW   b'00111100'      ;Enmascaro el registro ADCON0 para
	MOVWF   ADC_CH           ;conservar solo los bits del canal
	BCF     STATUS,C
	RRF     ADC_CH,F         ;Muevo los bits a la derecha dos posiciones
        RRF     ADC_CH,F         ;para manejar los bits del canal en decimal
	MOVF    ADC_CH,W         ;Pregunto si la conversi�n fue del canal 0
	SUBLW   .0
	BTFSC   STATUS,Z
	GOTO    READ_AN0
	MOVF    ADC_CH,W         ;Pregunto si la conversi�n fue del canal 1
	SUBLW   .1
	BTFSC   STATUS,Z
	GOTO    READ_AN1
	MOVF    ADC_CH,W         ;Pregunto si la conversi�n fue del canal 2
	SUBLW   .2
	BTFSC   STATUS,Z
	GOTO    READ_AN2
	GOTO    CLR_FLAG_ADC
	
    READ_AN0
        BANKSEL ADRESH
	MOVF    ADRESH,W
	BANKSEL LM35_VALUE
	MOVWF   LM35_VALUE       ;Guardo el valor le�do del LM35
	BANKSEL ADCON1           ;Para la segunda y tercera conversi�n seteo la
	BCF     ADCON1,VCFG0     ;referencia de tensi;on interna (VCC)
	BANKSEL ADCON0
	BCF     ADCON0,CHS3
	BCF     ADCON0,CHS2      ;Seteo el canal 1 para la proxima conversi�n
	BCF     ADCON0,CHS1
	BSF     ADCON0,CHS0
	BSF     ADCON0,GO        ;Inicio la pr�xima conversi�n
	GOTO    CLR_FLAG_ADC
	
    READ_AN1
        BANKSEL ADRESH
	MOVF    ADRESH,W
	BANKSEL POT1_VALUE
	MOVWF   POT1_VALUE       ;Guardo el valor le�do del primer pote
	BANKSEL ADCON0
	BCF     ADCON0,CHS3
	BCF     ADCON0,CHS2      ;Seteo el canal 2 para la proxima conversi�n
	BSF     ADCON0,CHS1
	BCF     ADCON0,CHS0
	BSF     ADCON0,GO        ;Inicio la pr�xima conversi�n
	GOTO    CLR_FLAG_ADC
	
    READ_AN2
        BANKSEL ADRESH
	MOVF    ADRESH,W
	BANKSEL POT2_VALUE
	MOVWF   POT2_VALUE       ;Guardo el valor le�do del segundo pote
	BANKSEL ADCON0
	BCF     ADCON0,CHS3
	BCF     ADCON0,CHS2      ;Seteo el canal 0 para la proxima conversi�n
	BCF     ADCON0,CHS1
	BCF     ADCON0,CHS0      ;Esta vez no inicio otra conversi�n ya que esto
	GOTO    CHECK_TEMP       ;lo har� la interrupci�n del TMR0 y lo que hago
	                         ;es enviar las conversiones
				 
    CHECK_TEMP
        MOVLW   .51
	BANKSEL LM35_VALUE
	SUBWF   LM35_VALUE,W
	BTFSC   STATUS,C
	GOTO    ALARM_ON
	GOTO    ALARM_OFF
	
    ALARM_ON
        BANKSEL PORTD
	BSF     L_ALARM
	BSF     BUZZER
	GOTO    SEND_DATA
	
    ALARM_OFF
        BANKSEL PORTD
	BCF     L_ALARM
	BCF     BUZZER
	GOTO    SEND_DATA
        
    SEND_DATA
        BCF     STATUS,RP0
	BCF     STATUS,RP1
	CALL    FLUSH_TX
	MOVLW   .3
	MOVWF   NRF_LENGTH
	CALL    W_TX_PAYLOAD
	BANKSEL PORTD
	CFG_DELAY_20us
	BSF     CE_PIN
	CALL    DELAY_3LOOP
	BCF     CE_PIN
	BANKSEL INTCON
	BSF     INTCON,RBIE
	GOTO    CLR_FLAG_ADC
	
    CLR_FLAG_ADC
        BANKSEL PIR1
	BCF     PIR1,ADIF
	GOTO    ISR_FIN
	
	
;*******************************************************************************
