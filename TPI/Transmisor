    CLRF    FLANKS
    CLRF    LIGHTS
    ENDM
    
CFG_CHS_SENSORS MACRO
    BANKSEL    ANSEL
    BSF        ANSEL,ANS0
    BSF        ANSEL,ANS1         ;RA0, RA1 y RA2 GPIOs Anal�gicos
    BSF        ANSEL,ANS2
    BANKSEL    TRISA
    BSF        TRISA,TRISA0       ;RA0: Entrada anal�gica (LM35)
    BSF        TRISA,TRISA1       ;RA1: Entrada anal�gica (Pote X)
    BSF        TRISA,TRISA2       ;RA2: Entrada anal�gica (Pote Y)
    ENDM
    
CFG_ADC MACRO
    BANKSEL    ADCON1
    BCF        ADCON1,ADFM        ;Conversi�n justificada a la izquierda
    BCF        ADCON1,VCFG1       ;Referencia negativa = VSS
    BCF        ADCON1,VCFG0       ;Referencia positiva = VCC
    BANKSEL    ADCON0
    BCF        ADCON0,ADCS1       ;Seteo la frecuencia del ADC en FOSC/8
    BSF        ADCON0,ADCS0
    BCF        ADCON0,CHS3        ;Inicialmente selecciono canal AN1
    BCF        ADCON0,CHS2
    BSF        ADCON0,CHS1
    BCF        ADCON0,CHS0
    BSF        ADCON0,ADON        ;ADC encendido
    ENDM
    
CFG_TMR0 MACRO
    BANKSEL    OPTION_REG
    BCF        OPTION_REG,T0CS    ;Clock del TMR0 = FOSC/4
    BCF        OPTION_REG,PSA     ;Prescaler asignado al TMR0
    BSF        OPTION_REG,PS2
    BSF        OPTION_REG,PS1     ;Prescaler = 1:1
    BSF        OPTION_REG,PS0
    BANKSEL    TMR0
    MOVLW      OFFSET_TMR0_VALUE
    MOVWF      OFFSET_TMR0
    MOVWF      TMR0
    MOVLW      CTR_MAX_TMR0_VALUE
    MOVWF      COUNTER_MAX_TMR0
    CLRF       COUNTER_TMR0
    ENDM
	
CFG_SPI MACRO
    BANKSEL TRISC
    BCF     TRISC,TRISC3          ;RC3 salida digital(SCK)
    BSF     TRISC,TRISC4          ;RC4 entrada digital(SDI)
    BCF     TRISC,TRISC5          ;RC5 salida digital(SDO)
    BANKSEL TRISD
    BCF     TRISD,TRISD1          ;RD1 salida digital(CSN)
    BCF     TRISD,TRISD0          ;RD0 salida digital(CE)
