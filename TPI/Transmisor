CFG_LEDS MACRO
    BANKSEL TRISD
    BCF     TRISD,TRISD7
    BCF     TRISD,TRISD6
    BCF     TRISD,TRISD5
    BCF     TRISD,TRISD4
    BCF     TRISD,TRISD3
    BCF     TRISD,TRISD2
    BANKSEL PORTD
    BCF     LED0
    BCF     LED1
    BCF     LED2
    BCF     LED3
    BCF     L_ALARM
    BCF     BUZZER
    ENDM
    
CFG_BUTTONS MACRO
    BANKSEL TRISB                 ;Pines del teclado
    BSF     TRISB,TRISB4          ;RB4 entrada digital
    BSF     TRISB,TRISB5          ;RB5 entrada digital
    BSF     TRISB,TRISB6          ;RB6 entrada digital
    BSF     TRISB,TRISB7          ;RB7 entrada digital
    BANKSEL ANSELH
    BCF     ANSELH,ANS11          ;Pin anal�gico AN11 desactivado
    BCF     ANSELH,ANS13          ;Pin anal�gico AN13 desactivado
    BANKSEL OPTION_REG
    BCF     OPTION_REG,NOT_RBPU   ;Resistencias pull-up internas habilitadas
    BANKSEL WPUB
    BSF     WPUB,WPUB4
    BSF     WPUB,WPUB5            ;Resistencias pull-up internas activas
    BSF     WPUB,WPUB6            ;para RB4,RB5,RB6 Y RB7
    BSF     WPUB,WPUB7
    BANKSEL IOCB
    BSF     IOCB,IOCB4
    BSF     IOCB,IOCB5            ;Activo interrupciones por cambio de nivel
    BSF     IOCB,IOCB6            ;en los pines RB4,RB5,RB6 y RB7
