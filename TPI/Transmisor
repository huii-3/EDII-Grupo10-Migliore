    MOVWF   SPBRG
    BANKSEL TXSTA
    BCF     TXSTA,SYNC
    BSF     TXSTA,BRGH
    BSF     TXSTA,TXEN
    BANKSEL RCSTA
    BSF     RCSTA,SPEN
    BANKSEL COUNTER_LM35
