    ENDM
    
CFG_DELAY_20us MACRO
    MOVLW   D'1'
    MOVWF   DELAY1_Init
    MOVLW   D'1'
    MOVWF   DELAY2_Init
    MOVLW   D'2'
    MOVWF   DELAY3_Init
    ENDM
    
CFG_DELAY_1ms5 MACRO
    MOVLW   D'13'
